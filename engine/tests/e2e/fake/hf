#!/usr/bin/env python3
"""hf download against HF_ENDPOINT: resumable .incomplete files, --exclude globs, the Hub's gated and not-found errors."""
import fnmatch
import json
import os
import sys
import urllib.error
import urllib.request

args = sys.argv[1:]
if len(args) < 2 or args[0] != "download":
    sys.exit("only `hf download` is supported here")
model = args[1]
opt = lambda flag: args[args.index(flag) + 1] if flag in args else None
local, rev = opt("--local-dir"), opt("--revision") or "main"
excludes = [args[i + 1] for i, a in enumerate(args) if a == "--exclude"]
endpoint = os.environ.get("HF_ENDPOINT", "https://huggingface.co").rstrip("/")
headers = {"Authorization": f"Bearer {os.environ['HF_TOKEN']}"} if os.environ.get("HF_TOKEN") else {}


def get(url, extra=None):
    req = urllib.request.Request(url, headers={**headers, **(extra or {})})
    return urllib.request.urlopen(req, timeout=30)


try:
    info = json.load(get(f"{endpoint}/api/models/{model}/revision/{rev}?blobs=true"))
    files = [s["rfilename"] for s in info["siblings"] if not any(fnmatch.fnmatch(s["rfilename"], p) for p in excludes)]
    for i, name in enumerate(files, 1):
        done = os.path.join(local, name)
        part = os.path.join(local, ".cache", "huggingface", "download", name + ".incomplete")
        os.makedirs(os.path.dirname(part), exist_ok=True)
        os.makedirs(os.path.dirname(done), exist_ok=True)
        have = os.path.getsize(part) if os.path.exists(part) else 0
        print(f"Fetching {len(files)} files: {i}/{len(files)}", file=sys.stderr)
        r = get(f"{endpoint}/{model}/resolve/{rev}/{name}", {"Range": f"bytes={have}-"} if have else None)
        with open(part, "ab" if have and r.status == 206 else "wb") as out:
            while chunk := r.read(1 << 16):
                out.write(chunk)
        os.replace(part, done)
except urllib.error.HTTPError as e:
    kind = "GatedRepoError" if e.code in (401, 403) else "RepositoryNotFoundError"
    print(f"{kind}: {e.code} Client Error for {model}", file=sys.stderr)
    sys.exit(1)
except urllib.error.URLError as e:
    print(f"httpx.ConnectError: {e.reason}", file=sys.stderr)
    sys.exit(1)
print(local)
