+def _marlin_global_scale(stored_weight_global_scale: torch.Tensor) -> torch.Tensor:
+    """Compressed-tensors stores the reciprocal of Marlin's multiplier."""
+    return (1.0 / stored_weight_global_scale.to(torch.float32)).reshape(1)
+
+
+def _prepare_marlin_sidecar(
+    layer: torch.nn.Module,
+    raw_weight: torch.Tensor,
+    raw_scale: torch.Tensor,
+    stored_weight_global_scale: torch.Tensor,
+) -> None:
+    tmp = torch.nn.Module()
+    tmp.output_size_per_partition = layer.output_size_per_partition
+    tmp.input_size_per_partition = layer.input_size_per_partition
+    tmp.params_dtype = layer.params_dtype
+    tmp.weight = Parameter(raw_weight.clone(), requires_grad=False)
+    tmp.weight_scale = Parameter(raw_scale.clone(), requires_grad=False)
+    tmp.weight_global_scale = Parameter(
+        _marlin_global_scale(stored_weight_global_scale).to(
+            device=stored_weight_global_scale.device
+        ),
+        requires_grad=False,
+    )
+    prepare_nvfp4_layer_for_marlin(tmp)
+    layer.marlin_weight = tmp.weight
+    layer.marlin_scale = tmp.weight_scale
+    layer.marlin_global_scale = tmp.weight_global_scale
+    layer.marlin_workspace = tmp.workspace
+
+
+def _release_stock_nvfp4_tensors(layer: torch.nn.Module) -> None:
+    for name in (
+        "weight_packed",
+        "weight_scale",
+        "alpha",
+        "input_global_scale",
+        "weight_global_scale",
+    ):
+        if not hasattr(layer, name):
+            continue
+        param = getattr(layer, name)
+        if isinstance(param, Parameter):
+            param.data = torch.empty(0, dtype=param.dtype, device=param.data.device)
+
