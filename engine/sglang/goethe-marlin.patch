+"""Env-driven NVFP4 Marlin routing for compressed-tensors linear layers."""
+
+import os
+
+import torch
+
+
+def _marlin_disabled() -> bool:
+    return os.environ.get("GOETHE_MARLIN", "1").strip().lower() in (
+        "0",
+        "false",
+        "no",
+        "off",
+    )
+
+
+def mode() -> str:
+    """Return stock, marlin_all, or marlin_small."""
+    if _marlin_disabled():
+        return "stock"
+    if os.environ.get("GOETHE_FORCE_PATH", "").strip().lower() == "w4a16":
+        return "marlin_all"
+    if torch.cuda.is_available():
+        major, _minor = torch.cuda.get_device_capability()
+        if major < 10:
+            return "marlin_all"
+    return "marlin_small"
+
+
+def max_rows() -> int:
+    return int(os.environ.get("GOETHE_MARLIN_MAX_ROWS", "128"))
