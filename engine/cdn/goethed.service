# Goethe systemd unit template for goethed; install.sh replaces __GOETHE_HOME__ with the resolved home.
[Unit]
Description=Goethe control plane daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=GOETHE_HOME=__GOETHE_HOME__
EnvironmentFile=-/etc/goethe/goethe.env
ExecStart=__GOETHE_HOME__/bin/goethed
KillMode=mixed
TimeoutStopSec=60
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
