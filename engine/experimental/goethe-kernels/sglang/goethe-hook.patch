+"""MeshApplied custom kernel loader for SGLang."""
+
+import logging
+import os
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+
+def load_goethe_kernels() -> bool:
+    """Load goethe kernel shared libraries from GOETHE_KERNEL_DIR."""
+    so_dir = os.environ.get("GOETHE_KERNEL_DIR", "")
+    if not so_dir or not os.path.isdir(so_dir):
+        return False
+    loaded_any = False
+    for fname in os.listdir(so_dir):
+        if fname.endswith(".so"):
+            torch.ops.load_library(os.path.join(so_dir, fname))
+            logger.info(f"[MeshApplied] Loaded custom kernel binary: {fname}")
+            loaded_any = True
+    if not loaded_any:
+        return False
+    op_names: list[str] = []
+    for schema in torch._C._jit_get_all_schemas():
+        qualified = schema.name
+        if qualified.startswith("goethe_kernels::"):
+            op_names.append(qualified.split("::", 1)[1])
+    for op_name in op_names:
+        getattr(torch.ops.goethe_kernels, op_name)
+    return len(op_names) > 0
+
+
+def goethe_marlin_max_rows() -> int:
+    """Row-count threshold for Marlin vs stock W4A4 on cc>=10 with goethe enabled."""
+    return int(os.environ.get("GOETHE_MARLIN_MAX_ROWS", "128"))
+
+
+def goethe_nvfp4_mode() -> str:
+    """Return NVFP4 linear routing: stock, marlin_all, or marlin_small."""
+    force = os.environ.get("GOETHE_FORCE_PATH", "").strip().lower()
+    if force == "w4a16":
+        return "marlin_all"
+
+    flag = False
+    try:
+        from sglang.srt.runtime_context import get_exec
+
+        flag = bool(get_exec().kernel.enable_goethe_fused_gemv)
+    except Exception:
+        flag = False
+
+    if not flag:
+        return "stock"
+
+    if not torch.cuda.is_available():
+        return "stock"
+
+    major, _minor = torch.cuda.get_device_capability()
+    if major < 10:
+        return "marlin_all"
+    return "marlin_small"
