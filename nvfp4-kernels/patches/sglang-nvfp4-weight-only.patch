+    def _is_fp4_nvfp4_weight_only(
+        self, weight_quant: QuantizationArgs, input_quant: QuantizationArgs
+    ) -> bool:
+        # Weight-only NVFP4 (compressed-tensors): experts are E2M1
+        # group-16 with no static activation scales; acts are quantized online.
+        if weight_quant is None or input_quant is not None:
+            return False
+        return (
+            weight_quant.type == QuantizationType.FLOAT
+            and weight_quant.num_bits == 4
+            and weight_quant.strategy == QuantizationStrategy.TENSOR_GROUP.value
+            and weight_quant.group_size == 16
+            and bool(weight_quant.symmetric)
+            and not weight_quant.dynamic
+        )
