# Mesh systemd unit template for meshd.
[Unit]
Description=Mesh control plane daemon
After=network.target

[Service]
Type=simple
Environment=MESH_HOME=/var/lib/mesh
EnvironmentFile=-/etc/mesh/mesh.env
ExecStart=/var/lib/mesh/bin/meshd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
